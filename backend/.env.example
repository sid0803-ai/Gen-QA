# Copy this file to `.env` (in this backend/ folder) and fill in real values
# before running the backend, either locally or via `docker compose up`.
#
#   cp backend/.env.example backend/.env
#
# Notes:
# - When running via `docker compose up`, the top-level docker-compose.yml
#   overrides DATABASE_URL and REDIS_URL with the in-network hostnames
#   (postgres/redis) automatically, so the values below only need to be
#   correct for running the backend directly on your host machine.
# - JWT_SECRET_KEY must be set to a long random value in any real deployment.

DATABASE_URL=postgresql+asyncpg://genqa:genqa@localhost:5432/genqa
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of frontend origins allowed to call this API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
